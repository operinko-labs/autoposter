# Production is Kubernetes, where this arrives as a Secret -- the line
# documents the URL's shape there. The development stack overrides it in
# docker-compose.yml, because inside the compose network the server is
# postgres:5432 rather than the host's published 5433.
AUTOPOSTER_DATABASE_URL=postgresql+asyncpg://autoposter:autoposter@localhost:5433/autoposter
AUTOPOSTER_PLEX_TOKEN=changeme
# Set the credential for each media server you configure; at least one server is required.
AUTOPOSTER_JELLYFIN_APIKEY=changeme
AUTOPOSTER_TMDB_TOKEN=changeme
AUTOPOSTER_TVDB_APIKEY=changeme
AUTOPOSTER_FANART_APIKEY=changeme
AUTOPOSTER_WEBHOOK_SECRET=changeme
# Optional: only the content rating is skipped while unset — every other
# metadata operation still runs (see app.py's _build_mdblist).
AUTOPOSTER_MDBLIST_APIKEY=changeme
# Optional, but not harmless if left unset: the bcrypt hash of the Web UI's
# admin password (never the plaintext password). See deploy/README.md's
# "Web UI authentication" section for how to generate one with
# hash_password(). Leaving this unset does not open the UI -- it does the
# opposite: every login attempt fails closed with 401, and nothing about the
# running service says why.
AUTOPOSTER_ADMIN_PASSWORD_HASH=changeme
# The sidebar's update check takes NO configuration and no credential. An
# image published by the release workflow is stamped with its own version and
# compares itself against the newest release on GitHub; any other build --
# anything you build yourself, and anything built from main -- reports
# `sha-<commit>`, which is not comparable to a release, so it makes no
# outbound request at all. There is nothing to set here and nothing to unset
# to switch it off; running a non-release image is what switches it off.
# Optional: the Tracearr public API key (a `trr_pub_...` value, minted in
# Tracearr's own settings). Unset, the two most-watched collection presets
# report themselves failed and nothing else changes -- every other pass runs
# exactly as before. The base URL is NOT here: it is `tracearr.base_url` in the
# YAML config, the same split radarr/sonarr use.
AUTOPOSTER_TRACEARR_APIKEY=changeme
# Optional: a read-only API key for callers that have no browser session (a
# Homepage customapi widget, a script). Presented as the X-API-Key header --
# the query string is never read -- and accepted on GET /api/status,
# GET /api/version, GET /api/stats/storage and GET /api/stats/runs only;
# every other route still needs a Web UI session.
# Unset, every keyed request is refused (401): the key path is off and
# closed, not open, the same posture as the admin hash above -- but only
# when unset. The admin hash fails closed even at its placeholder value
# (`changeme` is not a bcrypt hash); this key does not -- `changeme` here
# is a working read key until replaced, so copying this file to `.env`
# verbatim ships a real, guessable credential. Generate one with
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`;
# rotate by setting a new value and restarting.
AUTOPOSTER_API_KEY=changeme

# Optional: where the first-start setup wizard persists what it collects
# (`secrets.env` at 0600 and `autoposter.yaml`), and where every reader looks
# for a name the environment does not answer. Defaults to /state, which
# docker-compose.yml mounts as a named volume.
#
# The environment ALWAYS wins: any name set here or by compose is used in
# preference to the file, so filling this file in is exactly as it always was
# and the wizard never enters the picture. A stack with no .env at all boots
# into the wizard instead of refusing to start -- though this compose stack
# already sets AUTOPOSTER_CONFIG to the bundled example config, so what is
# actually missing there is credentials, not the config document.
AUTOPOSTER_STATE_DIR=/state
